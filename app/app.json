{
  "expo": {
    "name": "مجلس",
    "slug": "majlis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#18181b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181b"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "مجلس",
      "shortName": "مجلس",
      "lang": "ar",
      "dir": "rtl",
      "themeColor": "#1E3A2F",
      "backgroundColor": "#FAF9F6",
      "description": "مجلس — كتاب حديث صوتي تفاعلي مفتوح المصدر."
    },
    "experiments": {
      "baseUrl": "/majlis"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "majlis"
  }
}
